# 로컬: 복사 후 .env.local 로 저장하고 값을 채우세요.
# cp .env.example .env.local
# 이 파일에는 실제 비밀 키를 넣지 마세요.

# --- Supabase (대시보드 → Project Settings → API) ---
# API Route·서버에서 방 생성/삭제·호스트 비밀번호 검증 등에 필요
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 브라우저: RootLayout `<head>` 가 위 값을 window.__CAFE_SUPABASE_* 로만 주입함(클라이언트는 process.env 미사용)
# 서버 전용 (브라우저 번들 금지)
SUPABASE_SERVICE_ROLE_KEY=
# 코드에서 서비스 롤 별칭으로 읽음 (둘 중 하나만 있어도 됨)
SUPABASE_SECRET_KEY=

# --- 카카오 (개발자 콘솔 → 앱 키 → JavaScript 키) ---
# Web 플랫폼 사이트 도메인(localhost URL, 배포 도메인) 등록 필수
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 호스트 취합 보드 (방 비번 로그인 후 HttpOnly 쿠키 HMAC) ---
# 권장: 임의 긴 문자열. 미설정 시 SUPABASE_SERVICE_ROLE_KEY 로부터 파생(서버 로그에 경고)
ROOM_HOST_SECRET=

# 호스트 쿠키 Secure: true=항상 Secure, false=비사용, 미설정=production 에서만 Secure
# ROOM_HOST_COOKIE_SECURE=true
# ROOM_HOST_COOKIE_SECURE=false
