# 로컬에서는 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요.
# cp .env.example .env.local  (또는 수동 복사)
# 절대 실제 키를 이 파일에 넣지 마세요.

# Supabase (대시보드 → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 브라우저 번들에 넣지 말 것. Route Handler 에서만 사용
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 로그인 (카카오 개발자 콘솔 → 앱 키 → JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 선택: 호스트 취합 비밀번호 쿠키 서명 (미설정 시 일부 기능 제한 가능)
# ROOM_HOST_SECRET=
